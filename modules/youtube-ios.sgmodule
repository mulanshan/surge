#!name=YouTube Self iOS
#!desc=兼容旧链接的 YouTube 救援版：不修改 YouTube 响应体，优先恢复正常视频可见。
#!author=mulanshan
#!category=Enhance
#!tag=YouTube
#!openUrl=https://apps.apple.com/app/id544007664
#!arguments=启用调试模式:false
#!arguments-desc=- 调试参数：[true, false]\n\n兼容救援入口：暂时不运行响应脚本，不修改 browse/next/search/player/get_watch。
#!date=2026-05-07

[Rule]
AND,((DOMAIN-SUFFIX,googlevideo.com), (PROTOCOL,UDP)),REJECT
AND,((DOMAIN,youtubei.googleapis.com), (PROTOCOL,UDP)),REJECT

[Map Local]
^https?:\/\/www\.googleadservices\.com\/ data-type=text data="" status-code=204

[MITM]
hostname = %APPEND% www.googleadservices.com
