#!name=YouTube Self Enhance iOS
#!desc=完全自写可审计 YouTube 增强：JSON 去广告 + iOS player protobuf 去广告、后台播放、画中画。不含第三方脚本。
#!author=mulanshan
#!category=Enhance
#!tag=YouTube
#!openUrl=https://apps.apple.com/app/id544007664
#!arguments=屏蔽上传按钮:true,屏蔽选段按钮:true,屏蔽Shorts按钮:false,字幕翻译语言:off,歌词翻译语言:off,启用调试模式:false
#!arguments-desc=- 屏蔽参数：[true, false] \n- 翻译参数：[语言代码, off] \n\nprotobuf 部分仅改已知 player 字段：adPlacements/adSlots/pageadViewthroughconversion 与后台播放/画中画能力。
#!date=2026-04-28

[Rule]
AND,((DOMAIN-SUFFIX,googlevideo.com), (PROTOCOL,UDP)),REJECT
AND,((DOMAIN,youtubei.googleapis.com), (PROTOCOL,UDP)),REJECT

[Script]
youtube.self.response = type=http-response,pattern=^https:\/\/(youtubei\.googleapis\.com|www\.youtube\.com)\/youtubei\/v1\/(browse|next|player|search|reel\/reel_watch_sequence|guide|account\/get_setting(?:_values)?|get_watch)(\?.*)?$,requires-body=1,max-size=-1,binary-body-mode=1,script-path=https://raw.githubusercontent.com/mulanshan/surge/main/scripts/youtube/youtube-self.response.js,argument="{\"lyricLang\":\"{{{歌词翻译语言}}}\",\"captionLang\":\"{{{字幕翻译语言}}}\",\"blockUpload\":{{{屏蔽上传按钮}}},\"blockImmersive\":{{{屏蔽选段按钮}}},\"blockShorts\":{{{屏蔽Shorts按钮}}},\"debug\":{{{启用调试模式}}}}"

[Map Local]
^https?:\/\/[\w-]+\.googlevideo\.com\/initplayback.+&oad data-type=text data="" status-code=200
^https?:\/\/www\.youtube\.com\/pagead\/ data-type=text data="" status-code=204
^https?:\/\/www\.youtube\.com\/api\/stats\/ads data-type=text data="" status-code=204
^https?:\/\/s\.youtube\.com\/api\/stats\/(?:playback|qoe|watchtime)\?.*(?:adformat|adcontext|is_ad=1) data-type=text data="" status-code=204
^https?:\/\/www\.youtube\.com\/pcs\/activeview data-type=text data="" status-code=204
^https?:\/\/www\.youtube\.com\/ptracking\?.*pltype=ad(?:host|promoted) data-type=text data="" status-code=204
^https?:\/\/s\.youtube\.com\/api\/stats\/atr\?.*is_ad=1 data-type=text data="" status-code=204
^https?:\/\/googleads\.g\.doubleclick\.net\/ytcs\/adview data-type=text data="" status-code=204
^https?:\/\/www\.google(?:\.com|\.com\.hk)\/pagead\/ data-type=text data="" status-code=204
^https?:\/\/www\.google(?:\.com|\.com\.hk)\/ads\/on-device\/ data-type=text data="" status-code=204

[MITM]
hostname = %APPEND% *.googlevideo.com, youtubei.googleapis.com, www.youtube.com, s.youtube.com, googleads.g.doubleclick.net, www.google.com, www.google.com.hk
