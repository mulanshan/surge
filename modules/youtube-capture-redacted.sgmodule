#!name=YouTube Capture (Redacted)
#!desc=临时采样模块。把 iOS YouTube App 的 get_watch / player 响应保存到 Surge 本地持久存储。保存前自动把长 token 类字段替换成 R。仅作分析用，分析完即可删除。
#!author=mulanshan
#!category=Debug
#!date=2026-04-27

[Script]
yt.capture.redacted = type=http-response,pattern=^https:\/\/(youtubei\.googleapis\.com|www\.youtube\.com)\/youtubei\/v1\/(player|get_watch),requires-body=1,max-size=-1,binary-body-mode=1,script-path=https://raw.githubusercontent.com/mulanshan/surge/main/scripts/youtube/youtube-capture-redacted.response.js

[MITM]
hostname = %APPEND% youtubei.googleapis.com, www.youtube.com
