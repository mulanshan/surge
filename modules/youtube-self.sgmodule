#!name=YouTube Self
#!desc=自有可审计 YouTube 保守版：优先保证正常视频可见，只处理播放相关接口。不含第三方代码。
#!author=mulanshan
#!category=Enhance
#!tag=YouTube
#!openUrl=https://apps.apple.com/app/id544007664
#!arguments=启用调试模式:false
#!arguments-desc=- 调试参数：[true, false]\n\n保守入口：只处理 youtubei.googleapis.com 的 player/get_watch/account/get_setting。browse/next/search 首页、推荐、搜索和下一页接口全部原样放行，避免正常视频内容被误删。
#!date=2026-06-07

[Rule]
# 禁用 YouTube QUIC/HTTP3，避免视频初始化请求和核心 YouTube API 走 UDP 绕过 HTTPS 处理。
AND,((DOMAIN-SUFFIX,googlevideo.com), (PROTOCOL,UDP)),REJECT
AND,((DOMAIN,youtubei.googleapis.com), (PROTOCOL,UDP)),REJECT

[Script]
youtube.self.response = type=http-response,pattern=^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/(player|get_watch|account\/get_setting(?:_values)?)(\?.*)?$,requires-body=1,max-size=-1,binary-body-mode=1,script-path=https://raw.githubusercontent.com/mulanshan/surge/main/scripts/youtube/youtube-self.response.js,argument="{\"lyricLang\":\"off\",\"captionLang\":\"off\",\"blockUpload\":false,\"blockImmersive\":false,\"blockShorts\":false,\"debug\":{{{启用调试模式}}}}"

[Map Local]
^https?:\/\/www\.youtube\.com\/pagead\/ data-type=text data="" status-code=204
^https?:\/\/www\.googleadservices\.com\/ data-type=text data="" status-code=204
^https?:\/\/www\.youtube\.com\/pcs\/activeview data-type=text data="" status-code=204
^https?:\/\/www\.youtube\.com\/ptracking\?.*pltype=ad data-type=text data="" status-code=204

[MITM]
hostname = %APPEND% youtubei.googleapis.com, *.googlevideo.com, www.youtube.com, www.googleadservices.com
