#!name=YouTube Self Enhance iOS Local
#!desc=完全自写可审计 YouTube 增强：从 Surge iCloud 本地同步脚本加载，不访问 GitHub raw。
#!author=mulanshan
#!category=Enhance
#!tag=YouTube
#!openUrl=https://apps.apple.com/app/id544007664
#!arguments=屏蔽上传按钮:true,屏蔽选段按钮:true,屏蔽Shorts按钮:false,字幕翻译语言:off,歌词翻译语言:off,启用调试模式:false
#!arguments-desc=- 屏蔽参数：[true, false] \n- 翻译参数：[语言代码, off] \n\n本地同步版：模块与脚本放在 Surge 的 iCloud Documents 下，script-path 使用相对路径 scripts/youtube/youtube-self.response.js。命中记录会写入 Surge Logbook（支持时）。
#!date=2026-05-07

[Rule]
AND,((DOMAIN-SUFFIX,googlevideo.com), (PROTOCOL,UDP)),REJECT
AND,((DOMAIN,youtubei.googleapis.com), (PROTOCOL,UDP)),REJECT

[Script]
youtube.self.response = type=http-response,pattern=^https:\/\/(youtubei\.googleapis\.com|www\.youtube\.com)\/youtubei\/v1\/(browse|next|player|search|reel\/reel_watch_sequence|guide|account\/get_setting(?:_values)?|get_watch)(\?.*)?$,requires-body=1,max-size=-1,binary-body-mode=1,script-path=scripts/youtube/youtube-self.response.js,argument="{\"lyricLang\":\"{{{歌词翻译语言}}}\",\"captionLang\":\"{{{字幕翻译语言}}}\",\"blockUpload\":{{{屏蔽上传按钮}}},\"blockImmersive\":{{{屏蔽选段按钮}}},\"blockShorts\":{{{屏蔽Shorts按钮}}},\"debug\":{{{启用调试模式}}}}"

[Map Local]
^https?:\/\/[\w-]+\.googlevideo\.com\/initplayback.+&oad data-type=text data="" status-code=200
^https?:\/\/www\.youtube\.com\/pagead\/ data-type=text data="" status-code=204
^https?:\/\/www\.youtube\.com\/api\/stats\/ads data-type=text data="" status-code=204
^https?:\/\/s\.youtube\.com\/api\/stats\/qoe\?.*adcontext data-type=text data="" status-code=204
^https?:\/\/s\.youtube\.com\/api\/stats\/qoe\?.*adformat data-type=text data="" status-code=204
^https?:\/\/s\.youtube\.com\/api\/stats\/qoe\?.*is_ad=1 data-type=text data="" status-code=204
^https?:\/\/s\.youtube\.com\/api\/stats\/playback\?.*adcontext data-type=text data="" status-code=204
^https?:\/\/s\.youtube\.com\/api\/stats\/playback\?.*adformat data-type=text data="" status-code=204
^https?:\/\/s\.youtube\.com\/api\/stats\/playback\?.*is_ad=1 data-type=text data="" status-code=204
^https?:\/\/s\.youtube\.com\/api\/stats\/watchtime\?.*adcontext data-type=text data="" status-code=204
^https?:\/\/s\.youtube\.com\/api\/stats\/watchtime\?.*adformat data-type=text data="" status-code=204
^https?:\/\/s\.youtube\.com\/api\/stats\/watchtime\?.*is_ad=1 data-type=text data="" status-code=204
^https?:\/\/www\.youtube\.com\/pcs\/activeview data-type=text data="" status-code=204
^https?:\/\/www\.youtube\.com\/ptracking\?.*pltype=adhost data-type=text data="" status-code=204
^https?:\/\/www\.youtube\.com\/ptracking\?.*pltype=adpromoted data-type=text data="" status-code=204
^https?:\/\/s\.youtube\.com\/api\/stats\/atr\?.*is_ad=1 data-type=text data="" status-code=204
^https?:\/\/googleads\.g\.doubleclick\.net\/ytcs\/adview data-type=text data="" status-code=204
^https?:\/\/www\.google(?:\.com|\.com\.hk)\/pagead\/ data-type=text data="" status-code=204
^https?:\/\/www\.google(?:\.com|\.com\.hk)\/ads\/on-device\/ data-type=text data="" status-code=204

[MITM]
hostname = %APPEND% *.googlevideo.com, youtubei.googleapis.com, www.youtube.com, s.youtube.com, googleads.g.doubleclick.net, www.google.com, www.google.com.hk
