#!name=YouTube Self Fast
#!desc=自有可审计 YouTube 快速版：只处理播放核心接口，减少首屏响应脚本和 MITM 范围。
#!author=mulanshan
#!category=Enhance
#!tag=YouTube
#!openUrl=https://apps.apple.com/app/id544007664
#!arguments=启用调试模式:false
#!arguments-desc=- 调试参数：[true, false]\n\n速度优先：只匹配 youtubei.googleapis.com 的 player/get_watch 响应，不处理 browse/next/search/guide/account/get_setting/reel 等首屏和信息流接口。
#!date=2026-06-07

[Rule]
# 禁用 YouTube QUIC/HTTP3，避免视频初始化请求和核心播放 API 走 UDP 绕过 HTTPS 处理。
AND,((DOMAIN-SUFFIX,googlevideo.com), (PROTOCOL,UDP)),REJECT
AND,((DOMAIN,youtubei.googleapis.com), (PROTOCOL,UDP)),REJECT

[Script]
youtube.self.fast.response = type=http-response,pattern=^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/(player|get_watch)(\?.*)?$,requires-body=1,max-size=-1,binary-body-mode=1,script-path=https://raw.githubusercontent.com/mulanshan/surge/main/scripts/youtube/youtube-self.response.js,argument="{\"lyricLang\":\"off\",\"captionLang\":\"off\",\"blockUpload\":false,\"blockImmersive\":false,\"blockShorts\":false,\"debug\":{{{启用调试模式}}}}"

[Map Local]
^https?:\/\/[\w-]+\.googlevideo\.com\/initplayback.+&oad data-type=text data="" status-code=200

[MITM]
hostname = %APPEND% youtubei.googleapis.com, *.googlevideo.com
