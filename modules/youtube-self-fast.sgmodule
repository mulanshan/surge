#!name=YouTube Self Fast
#!desc=兼容旧链接的 YouTube 统一版：等同 YouTube Self，建议新安装统一使用 youtube-self.sgmodule。
#!author=mulanshan
#!category=Enhance
#!tag=YouTube
#!openUrl=https://apps.apple.com/app/id544007664
#!arguments=启用调试模式:false
#!arguments-desc=- 调试参数：[true, false]\n\n兼容入口：此文件保留给已经安装 youtube-self-fast.sgmodule 的设备。新设备请统一使用 modules/youtube-self.sgmodule。
#!date=2026-06-07

[Rule]
# 禁用 YouTube QUIC/HTTP3，避免视频初始化请求和核心播放 API 走 UDP 绕过 HTTPS 处理。
AND,((DOMAIN-SUFFIX,googlevideo.com), (PROTOCOL,UDP)),REJECT
AND,((DOMAIN,youtubei.googleapis.com), (PROTOCOL,UDP)),REJECT

[Script]
youtube.self.response = type=http-response,pattern=^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/(browse|player|get_watch)(\?.*)?$,requires-body=1,max-size=-1,binary-body-mode=1,script-path=https://raw.githubusercontent.com/mulanshan/surge/main/scripts/youtube/youtube-self.response.js,argument="{\"lyricLang\":\"off\",\"captionLang\":\"off\",\"blockUpload\":false,\"blockImmersive\":false,\"blockShorts\":false,\"debug\":{{{启用调试模式}}}}"

[Map Local]
^https?:\/\/[\w-]+\.googlevideo\.com\/initplayback.+&oad data-type=text data="" status-code=200

[MITM]
hostname = %APPEND% youtubei.googleapis.com, *.googlevideo.com
