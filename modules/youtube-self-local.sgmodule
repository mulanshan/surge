#!name=YouTube Self Local
#!desc=自有可审计 YouTube 统一本地版：兼顾打开速度、首页广告削弱、后台播放与画中画。
#!author=mulanshan
#!category=Enhance
#!tag=YouTube
#!openUrl=https://apps.apple.com/app/id544007664
#!arguments=启用调试模式:false
#!arguments-desc=- 调试参数：[true, false]\n\n本地脚本版：只处理 youtubei.googleapis.com 的 browse/player/get_watch，script-path 使用 scripts/youtube/youtube-self.response.js。
#!date=2026-06-07

[Rule]
# 禁用 YouTube QUIC/HTTP3，避免视频初始化请求和核心 YouTube API 走 UDP 绕过 HTTPS 处理。
AND,((DOMAIN-SUFFIX,googlevideo.com), (PROTOCOL,UDP)),REJECT
AND,((DOMAIN,youtubei.googleapis.com), (PROTOCOL,UDP)),REJECT

[Script]
youtube.self.response = type=http-response,pattern=^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/(browse|player|get_watch)(\?.*)?$,requires-body=1,max-size=-1,binary-body-mode=1,script-path=scripts/youtube/youtube-self.response.js,argument="{\"lyricLang\":\"off\",\"captionLang\":\"off\",\"blockUpload\":false,\"blockImmersive\":false,\"blockShorts\":false,\"debug\":{{{启用调试模式}}}}"

[Map Local]
^https?:\/\/[\w-]+\.googlevideo\.com\/initplayback.+&oad data-type=text data="" status-code=200

[MITM]
hostname = %APPEND% youtubei.googleapis.com, *.googlevideo.com
