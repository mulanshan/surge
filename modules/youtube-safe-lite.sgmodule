#!name=YouTube Safe Lite
#!desc=自写安全版 YouTube 广告削弱模块。无第三方脚本，仅拦截 QUIC 并空响应部分广告初始化请求。
#!author=mulanshan
#!category=AdBlock
#!tag=YouTube
#!openUrl=https://apps.apple.com/app/id544007664
#!date=2026-04-27

[Rule]
# 禁用 YouTube QUIC/HTTP3，避免部分视频流和 API 走 UDP 绕过规则与 HTTPS 处理。
AND,((DOMAIN-SUFFIX,googlevideo.com), (PROTOCOL,UDP)),REJECT
AND,((DOMAIN,youtubei.googleapis.com), (PROTOCOL,UDP)),REJECT

[Map Local]
# 部分 googlevideo 播放初始化广告请求会带 oad 参数，返回空响应可减少贴片广告初始化。
^https?:\/\/[\w-]+\.googlevideo\.com\/initplayback.+&oad data-type=text data="" status-code=200

[MITM]
# 仅为了让上面的 HTTPS Map Local 生效。不执行脚本，不修改 YouTube API 响应体。
hostname = %APPEND% *.googlevideo.com
