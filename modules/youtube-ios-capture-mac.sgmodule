#!name=YouTube iOS Capture to Mac
#!desc=临时诊断模块：采集 iOS YouTube player/get_watch 响应，先脱敏再发送到 Mac 192.168.50.102:18765。采完请删除。
#!author=mulanshan
#!category=Debug
#!date=2026-04-28

[Script]
yt.ios.capture.mac = type=http-response,pattern=^https:\/\/(youtubei\.googleapis\.com|www\.youtube\.com)\/youtubei\/v1\/(player|get_watch)(\?.*)?$,requires-body=1,max-size=-1,binary-body-mode=1,script-path=https://raw.githubusercontent.com/mulanshan/surge/main/scripts/youtube/youtube-ios-capture-mac.response.js

[MITM]
hostname = %APPEND% youtubei.googleapis.com, www.youtube.com
