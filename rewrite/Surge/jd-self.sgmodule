#!name=京东 Self
#!desc=自有可审计京东去广告模块：清理开屏、首页/我的页营销卡、弹层和搜索推荐，并可关闭京东诊断上报。不含第三方脚本，不修改账号、订单、支付或会员状态。
#!author=mulanshan
#!category=AdBlock
#!tag=京东
#!openUrl=https://apps.apple.com/cn/app/id414245413
#!arguments=启用调试模式:false,禁用京东诊断:true,清理订单推广:true
#!arguments-desc=- 调试参数：[true, false]\n- 禁用京东诊断：[true, false]\n- 清理订单推广：[true, false]\n\n兼容 api.m.jd.com 的 /、/api、/client.action 三种当前入口；脚本只处理内置白名单 functionId，未知接口立即原样放行。保留登录、购物车、商品详情、下单、支付、退款、地址、物流主体、PLUS 和优惠权益。
#!system=ios
#!requirement=CORE_VERSION>=20 && SYSTEM = 'iOS'
#!date=2026-07-13

[Rule]
# 京东随机诊断子域。仅拒绝明确的 /diagnose 请求，不整域拦截 jddebug.com。
URL-REGEX,^http:\/\/[a-fA-F0-9]{32}\.jddebug\.com\/diagnose\?,REJECT,extended-matching

[Script]
jd.self.response = type=http-response,pattern=^https:\/\/api\.m\.jd\.com\/(?:client\.action|api)?(?:\?.*)?$,requires-body=1,max-size=4194304,script-path=https://raw.githubusercontent.com/mulanshan/surge/surge-self-v2026.07.13/rewrite/Surge/scripts/jd/jd-self.response.js?v=20260713-1,argument="{\"debug\":{{{启用调试模式}}},\"disableDiagnostics\":{{{禁用京东诊断}}},\"cleanOrderPromotions\":{{{清理订单推广}}}}"

[MITM]
hostname = %APPEND% api.m.jd.com
