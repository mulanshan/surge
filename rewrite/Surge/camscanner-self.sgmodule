#!name=扫描全能王 Self
#!desc=自有可审计扫描全能王去广告模块：清理启动弹窗、运营活动、广告配置和统计采集。不含第三方脚本，不伪造会员权限。
#!author=mulanshan
#!category=AdBlock
#!tag=扫描全能王
#!openUrl=https://apps.apple.com/app/id388627783
#!arguments=启用调试模式:false
#!arguments-desc=- 调试参数：[true, false]\n\n范围：只处理扫描全能王 / CamScanner 的广告、活动弹窗、运营位、广告配置和统计采集。保留账号、云同步、OCR、PDF 转换、购买校验和主业务接口；不修改 purchase/cs/query_property 等会员状态接口。
#!date=2026-06-09

[Rule]
# 明确广告、统计、崩溃/行为采集域名。保留 intsig / camscanner 主业务域，不做整域拒绝。
DOMAIN,ad.intsig.net,REJECT
DOMAIN,ads.intsig.net,REJECT
DOMAIN,adstat.intsig.net,REJECT
DOMAIN,log.intsig.net,REJECT
DOMAIN,track.intsig.net,REJECT
DOMAIN,tracking.intsig.net,REJECT
DOMAIN,analytics.intsig.net,REJECT
DOMAIN,stat.intsig.net,REJECT
DOMAIN,stats.intsig.net,REJECT
DOMAIN,event.intsig.net,REJECT
DOMAIN,events.intsig.net,REJECT
DOMAIN,crash.intsig.net,REJECT
DOMAIN,data.camscanner.com,REJECT

# 常见第三方广告/归因/统计 SDK。只拦广告和上报域，避免影响 App Store / Apple 购买校验。
DOMAIN-SUFFIX,doubleclick.net,REJECT
DOMAIN-SUFFIX,googleadservices.com,REJECT
DOMAIN-SUFFIX,googlesyndication.com,REJECT
DOMAIN,a.gdt.qq.com,REJECT
DOMAIN,sdk.e.qq.com,REJECT
DOMAIN,apmplus.volces.com,REJECT
DOMAIN-SUFFIX,appsflyer.com,REJECT
DOMAIN-SUFFIX,app-measurement.com,REJECT
DOMAIN-SUFFIX,adjust.com,REJECT

[Script]
camscanner.self.response = type=http-response,pattern=^https?:\/\/(?:[^\/]+\.)?(?:intsig\.net|camscanner\.com)\/(?!(?:purchase\/cs\/query_property|.+\/purchase\/cs\/query_property)(?:\?|$)).*(?:ad|ads|advert|banner|campaign|commercial|config|market|marketing|notice|operate|operation|popup|promotion|recommend|splash|startup)(?:[^\/?]*)(?:\?.*)?$,requires-body=1,max-size=-1,script-path=https://raw.githubusercontent.com/mulanshan/surge/main/rewrite/Surge/scripts/camscanner/camscanner-self.response.js?v=20260609,argument="{\"debug\":{{{启用调试模式}}}}"

[Map Local]
# 明显广告/统计/活动接口，优先返回空对象，避免触发客户端重试。购买、账号、云同步和 OCR/PDF 接口不在此范围内。
^https?:\/\/(?:[^\/]+\.)?(?:intsig\.net|camscanner\.com)\/(?:ad|ads|advert|advertise|advertisement)(?:\/|\?|$) data-type=text data="{}" status-code=200
^https?:\/\/(?:[^\/]+\.)?(?:intsig\.net|camscanner\.com)\/.*\/(?:ad|ads|advert|banner|splash|popup)(?:\/|\?|$) data-type=text data="{}" status-code=200
^https?:\/\/(?:[^\/]+\.)?(?:intsig\.net|camscanner\.com)\/.*(?:log|stat|track|trace|event|analytics|monitor|collect)(?:\/|\?|$) data-type=text data="" status-code=204

# Google / 第三方广告统计。不会触碰 Apple StoreKit 收据校验。
^https?:\/\/(?:googleads\.g\.doubleclick\.net|www\.googleadservices\.com|pagead2\.googlesyndication\.com)\/ data-type=text data="" status-code=204
^https?:\/\/(?:a\.gdt\.qq\.com|sdk\.e\.qq\.com)\/ data-type=text data="" status-code=204
^https?:\/\/apmplus\.volces\.com\/ data-type=text data="" status-code=204
^https?:\/\/(?:app-measurement\.com|(?:[^\/]+\.)?appsflyer\.com|(?:[^\/]+\.)?adjust\.com)\/ data-type=text data="" status-code=204

[MITM]
hostname = %APPEND% *.intsig.net, *.camscanner.com, googleads.g.doubleclick.net, www.googleadservices.com, pagead2.googlesyndication.com, a.gdt.qq.com, sdk.e.qq.com, apmplus.volces.com, app-measurement.com, *.appsflyer.com, *.adjust.com
