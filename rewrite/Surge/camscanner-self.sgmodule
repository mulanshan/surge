#!name=扫描全能王
#!desc=固定云端订阅，自有可审计扫描全能王专用模块：只处理第一方开屏、活动弹窗、运营位和广告采集接口，兼容 camscanner 与 intsig 双 API 主机。通用广告网络由基础去广告模块负责。
#!author=mulanshan
#!category=AdBlock
#!tag=扫描全能王
#!openUrl=https://apps.apple.com/app/id388627783
#!arguments=清理明确广告:true,启用调试模式:false
#!arguments-desc=- 清理明确广告：[true, false]，默认 true；清理第一方开屏(get_startpic)、广告配置与功能活动弹窗\n- 调试参数：[true, false]\n\n范围：只处理扫描全能王 / CamScanner 的广告、活动弹窗、运营位、广告配置和统计采集。保留账号、云同步、OCR、PDF 转换、购买校验和主业务接口；不修改 purchase/cs/query_property 等会员状态接口。
#!system=ios
#!requirement=CORE_VERSION>=20 && SYSTEM = 'iOS'
#!date=2026-11-13

[Rule]
# 明确广告、统计、崩溃/行为采集域名。保留 intsig / camscanner 主业务域，不做整域拒绝。
DOMAIN,ad.intsig.net,REJECT
DOMAIN,ads.intsig.net,REJECT
DOMAIN,adstat.intsig.net,REJECT
DOMAIN,log.intsig.net,REJECT
DOMAIN,track.intsig.net,REJECT
DOMAIN,tracking.intsig.net,REJECT
DOMAIN,analytics.intsig.net,REJECT
DOMAIN,stat.intsig.net,REJECT
DOMAIN,stats.intsig.net,REJECT
DOMAIN,event.intsig.net,REJECT
DOMAIN,events.intsig.net,REJECT
DOMAIN,crash.intsig.net,REJECT
DOMAIN,apm-collector-uc.intsig.net,REJECT
DOMAIN,sentry.intsig.net,REJECT
DOMAIN,data.camscanner.com,REJECT

[Script]
camscanner.self.response = type=http-response,pattern=^https?:\/\/(?:open\.camscanner\.com|api(?:-cs)?\.intsig\.net)\/+(?:sync\/(?:get_ad_(?:data|control|cfg)|get_page_cfg(?:_v2)?|get_new_func_popup_cfg)|user\/cs\/operating\/app\/get_startpic)(?:\?.*)?$,requires-body=1,max-size=2097152,debug={{{启用调试模式}}},script-path=https://raw.githubusercontent.com/mulanshan/surge/surge-self-v2026.11.13.2/rewrite/Surge/scripts/camscanner/camscanner-self.response.js?v=20261113-3,argument="{\"cleanAds\":{{{清理明确广告}}},\"debug\":{{{启用调试模式}}}}"

[Map Local]
# 明显广告行为上报接口返回合法空 JSON，避免触发客户端重试。购买、账号、云同步和 OCR/PDF 接口不在此范围内。
^https?:\/\/(?:open\.camscanner\.com|api(?:-cs)?\.intsig\.net)\/+sync\/upload_ad_record(?:\?.*)?$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[MITM]
hostname = %APPEND% open.camscanner.com, api.intsig.net, api-cs.intsig.net
