#!name=基础去广告模块
#!desc=基于本机 Surge 日志与社区资料交叉验证的通用域名级去广告。只拦明确广告网络；无脚本、无 MITM、无响应改写。
#!author=mulanshan
#!category=AdBlock
#!tag=基础去广告
#!date=2026-07-12

[Rule]
# Google 广告网络。来自 iPhone 请求日志与 Mac 月度流量统计。
DOMAIN-SUFFIX,doubleclick.net,REJECT
DOMAIN-SUFFIX,googleadservices.com,REJECT
DOMAIN-SUFFIX,googlesyndication.com,REJECT
DOMAIN-SUFFIX,googleadsserving.cn,REJECT

# 腾讯广告 SDK。只拦明确广告入口，不拒绝 qq.com / e.qq.com 整域。
DOMAIN,a.gdt.qq.com,REJECT
DOMAIN,mi.gdt.qq.com,REJECT
DOMAIN,sdk.e.qq.com,REJECT
DOMAIN,api.iegadp.qq.com,REJECT

# 穿山甲 / 字节广告 SDK 与广告素材。保留 snssdk、zijieapi、byteimg 主域及混合用途接口。
DOMAIN,api-access.pangolin-sdk-toutiao.com,REJECT
DOMAIN,api-access.pangolin-sdk-toutiao-b.com,REJECT
DOMAIN,api-access.pangolin-sdk-toutiao-b1.com,REJECT
DOMAIN,api-access.pangolin-sdk-toutiao-p.com,REJECT
DOMAIN,sf3-be-pack.pglstatp-toutiao.com,REJECT
DOMAIN,sf3-fe-tos.pglstatp-toutiao.com,REJECT
DOMAIN,ads3-normal.zijieapi.com,REJECT
DOMAIN,ads5-normal.zijieapi.com,REJECT
DOMAIN,ads3-normal-lq.zijieapi.com,REJECT
DOMAIN,ads5-normal-lq.zijieapi.com,REJECT
DOMAIN,ads3-normal-hl.zijieapi.com,REJECT
DOMAIN,ads5-normal-hl.zijieapi.com,REJECT
DOMAIN,p3-ad-sign.byteimg.com,REJECT
DOMAIN,p6-ad-sign.byteimg.com,REJECT
DOMAIN,p9-ad-sign.byteimg.com,REJECT
DOMAIN,dig.bdurl.net,REJECT

# 本机浏览器流量中持续出现的独立广告网络。
DOMAIN-SUFFIX,adnxs.com,REJECT
DOMAIN-SUFFIX,adnxs-simple.com,REJECT
DOMAIN-SUFFIX,adsafeprotected.com,REJECT
DOMAIN-SUFFIX,ad-score.com,REJECT
DOMAIN-SUFFIX,ad-m.net,REJECT
DOMAIN-SUFFIX,adkernel.com,REJECT
DOMAIN-SUFFIX,teads.tv,REJECT
