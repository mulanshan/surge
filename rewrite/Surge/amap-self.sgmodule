#!name=高德地图
#!desc=固定云端订阅，自有可审计高德地图去广告模块：清理开屏、消息盒子、首页推荐、搜索热词和明显广告接口，支持可选周边推广精简与仅限高德 UA 的 HTTPDNS 阻断，覆盖 m5、m5-zb、m5-x 与 m6 主机。不含第三方脚本。
#!author=mulanshan
#!category=AdBlock
#!tag=高德地图
#!openUrl=https://apps.apple.com/app/id461703208
#!arguments=清理明确广告:true,精简周边与出行推广:false,高德HTTPDNS策略:REJECT,启用调试模式:false
#!arguments-desc=- 清理明确广告：[true, false]，默认 true；清理开屏广告、消息盒子营销通知、首页广告卡与搜索热词推广\n- 精简周边与出行推广：[true, false]，默认 false；开启后额外精简首页 pull3/活动运营卡与足迹推广横幅(afootprint)\n- 高德HTTPDNS策略：[REJECT, DIRECT]，默认 REJECT；仅在 User-Agent 为 AMap* 时阻断 amdc.m.taobao.com 直连 IP 调度，完全不影响淘宝/支付宝\n- 调试参数：[true, false]\n\n地图瓦片、定位、导航、路线规划、天气/通勤/常去地点、打车订单、账号和素材资源不拦截。
#!system=ios
#!requirement=CORE_VERSION>=20 && SYSTEM = 'iOS'
#!date=2026-11-13

[Rule]
# adashx 是高德/友盟统计域，真实抓包里可能以 TCP 形态出现，Map Local 不一定能接住。
DOMAIN,adashx.ut.amap.com,REJECT
# 仅针对高德客户端 UA 阻断阿里系共享 HTTPDNS，避免影响淘宝/支付宝。
AND,((DOMAIN,amdc.m.taobao.com), (USER-AGENT,AMap*)),{{{高德HTTPDNS策略}}}

[Script]
amap.self.response = type=http-response,pattern=^https?:\/\/(?:m5|m5-zb|m5-x|m6)\.amap\.com\/+ws\/(?:(?:valueadded|aos)\/alimama\/splash_screen(?:_rt)?|msgbox\/pull|message\/notice\/list|faas\/amap-navigation\/main-page|shield\/dsp\/profile\/index\/nodefaas|shield\/search\/new_hotword|shield\/frogserver\/afootprint)(?:\?.*)?$,requires-body=1,max-size=2097152,debug={{{启用调试模式}}},script-path=https://raw.githubusercontent.com/mulanshan/surge/surge-self-v2026.11.13.2/rewrite/Surge/scripts/amap/amap-self.response.js?v=20261113-3,argument="{\"cleanAds\":{{{清理明确广告}}},\"cleanNearbyPromotions\":{{{精简周边与出行推广}}},\"debug\":{{{启用调试模式}}}}"

[Map Local]
# 明显广告/归因接口，返回空对象或空响应即可；避免对天气、导航、搜索主业务做整接口拦截。
^https?:\/\/(?:m5|m5-zb|m5-x|m6)\.amap\.com\/+ws\/asa\/ads_attribution(?:\?.*)?$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
^https?:\/\/(?:m5|m5-zb|m5-x|m6)\.amap\.com\/+ws\/shield\/scene\/recommend(?:\?.*)?$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
^https?:\/\/(?:m5|m5-zb|m5-x|m6)\.amap\.com\/+ws\/boss\/order_web\/\w{8}_information(?:\?.*)?$ data-type=text data="" status-code=204
^https?:\/\/(?:m5|m5-zb|m5-x|m6)\.amap\.com\/uploadimg\/\w+\.gif(?:\?.*)?$ data-type=text data="" status-code=204

# 启动和页面统计采集。真实请求来自 iPhone 高德地图 2026-06-08 抓包。
^https?:\/\/awaken\.amap\.com\/+ws\/h5_log(?:\?.*)?$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
^https?:\/\/(?:m5|m5-zb|m5-x|m6)\.amap\.com\/+ws\/shield\/(?:alc\/collect|amapstream\/upload)(?:\?.*)?$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[MITM]
hostname = %APPEND% m5.amap.com, m5-zb.amap.com, m5-x.amap.com, m6.amap.com, awaken.amap.com
